# Copy to .env for local development and tests:  cp .env.example .env
# Never commit .env. Staging and production read real environment variables on the server
# (architecture 5.1); they never read a .env file.
#
# Generate secrets with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------- required everywhere
SECRET_KEY=
# HMAC key for OTP codes. Separate from SECRET_KEY (architecture 5 A02).
OTP_HMAC_KEY=
# PostgreSQL only. Tests create and drop test_<name> automatically.
DATABASE_URL=postgres://postgres@localhost:5432/matchvia

# ---------------------------------------------------------------- optional in dev
# Admin URL prefix. Production requires a private value (not "admin/").
ADMIN_URL_PATH=admin/

# ---------------------------------------------------------------- staging and production only
# ALLOWED_HOSTS=matchvia.lk,www.matchvia.lk
# CSRF_TRUSTED_ORIGINS=https://matchvia.lk,https://www.matchvia.lk
# SECRET_KEY_FALLBACKS=
# SMS_BACKEND=notifications.backends.textlk.TextLkBackend
# Add ?sslmode=require to DATABASE_URL in staging and production.
# Added in later steps: SMS_API_KEY, SMS_SENDER_ID (S08/C7), TURNSTILE_SITE_KEY,
# TURNSTILE_SECRET_KEY (D5), STORAGE_* (S21), SENTRY_DSN (S30).
